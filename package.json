{
  "name": "isshelf",
  "version": "0.1.0",
  "private": false,
  "description": "isShelf by Iswebro — a console-first PS5 homebrew library",
  "author": "Iswebro",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node tools/test-orbit.js && node tools/verify-preview.js",
    "test:native": "node tools/test-native.js",
    "build:native-host": "node tools/build-native-host.js",
    "test:native-renderer": "node tools/build-native-host.js && node tools/test-native-renderer.js",
    "test:room": "node tools/test-room.js",
    "test:movie": "node tools/test-movie.js",
    "test:library-ftp": "node tools/test-library-ftp.js",
    "test:launch-client": "node tools/test-launch-client.js",
    "prepare:ps5-ui-test": "node tools/build-package-art.js && node tools/build-ps5.js prepare_ps5_test.py",
    "prepare:ps5-sources": "node tools/build-ps5.js prepare_corresponding_source.py",
    "relink:ps5": "node tools/build-ps5.js relink_ps5.py",
    "prepare:ps5-source-kit": "node tools/build-ps5.js prepare_ps5_source_kit.py",
    "prepare:ps5-release": "node tools/build-ps5.js prepare_ps5_release.py",
    "start:native-host": "node tools/run-native-host.js",
    "build:ps5": "node tools/build-ps5.js",
    "build:ps5-launch-helper": "node tools/build-ps5.js build_launch_helper.py",
    "test:ps5-platform": "node tools/build-ps5.js test_ps5_platform.py",
    "verify:ps5": "node tools/build-ps5.js verify_ps5_build.py",
    "test:ps5-verifier": "node tools/build-ps5.js test_ps5_verifier.py",
    "test:ps5-release-inputs": "node tools/build-ps5.js test_ps5_release_inputs.py",
    "verify:ps5-release-inputs": "node tools/build-ps5.js prepare_ps5_release.py --verify-inputs-only",
    "build:native-catalog": "node tools/build-native-catalog.js",
    "build:systems": "node tools/build-support-list.js",
    "build:icons": "node tools/build-icon-manifest.js",
    "build:art-layout": "node tools/build-art-layout.js",
    "build:scene-layout": "node tools/build-scene-layout.js"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
