* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.png -text
*.mp4 -text
*.mpg -text
*.ttf -text
# Preserve hash-pinned upstream bytes, including their original license whitespace.
native/third_party/stb/*.h -text -whitespace
native/third_party/cjson/* -text -whitespace
native/third_party/pl_mpeg/*.h -text -whitespace
native/third_party/licenses/* -text -whitespace
native/assets/fonts/* -text -whitespace
native/third_party/ps5-runtime/** -text -whitespace
native/third_party/ps5-runtime/SOURCE.json text eol=lf
